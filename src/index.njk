---
permalink: /index.html
layout: layouts/base.njk
eleventyComputed:
  title: "{{ home.title }}"
  metaDescription: "{{ home.metaDescription }}"
---
{% block extraHead %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "{{ site.name }}",
  "jobTitle": "{{ site.role }}",
  "url": "{{ site.baseUrl }}",
  "sameAs": ["{{ site.linkedin }}"],
  "description": "Senior Project Manager specialized in transition management, operational excellence, and international delivery."
}
</script>
{% endblock %}

<!-- ─── CINEMATIC HERO ─── -->
<section class="hero hero-cine">
  <div class="hero-cine-mesh" aria-hidden="true"></div>
  <div class="container-narrow hero-cine-content">
    <span class="hero-cine-rule" aria-hidden="true"></span>
    <p class="eyebrow reveal">{{ home.hero.eyebrow }}</p>
    <h1 class="hero-h1 hero-cine-h1 reveal" data-delay="1">
      {{- home.hero.heading | safe | replace("\n", "<br>") -}}
    </h1>
    <p class="hero-lede reveal" data-delay="2">{{ home.hero.lede | safe }}</p>
    <p class="hero-offering reveal" data-delay="3">{{ home.hero.offering }}</p>
    <div class="hero-ctas reveal" data-delay="4">
      <a href="{{ home.hero.ctaPrimaryUrl }}" class="btn btn-primary">{{ home.hero.ctaPrimaryLabel }}</a>
      <a href="{{ home.hero.ctaLinkUrl }}" class="btn-link">{{ home.hero.ctaLinkLabel }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <a href="#scroll-anchor" class="hero-cine-scroll reveal" data-delay="4" aria-label="Scroll down">
    <span class="hero-cine-scroll-label">Scroll</span>
    <span class="hero-cine-scroll-line" aria-hidden="true"></span>
  </a>
</section>
<div id="scroll-anchor"></div>

<!-- ─── LIGHTHOUSE PROJECTS ─── -->
<section class="band">
  <div class="container">
    <header class="band-header reveal">
      <p class="eyebrow">{{ home.selectedProjects.eyebrow }}</p>
      <h2 class="t-display-lg">{{ home.selectedProjects.heading }}</h2>
    </header>
    <div class="lighthouse-grid">
      {% for e in collections.featuredEngagements -%}
      <a href="/projects.html#{{ e.data.slug }}" class="lh-card reveal" data-delay="{{ loop.index }}">
        <div class="lh-card-img"><img src="{{ e.data.featuredImage }}" alt="" loading="lazy"></div>
        <div class="lh-card-body">
          <p class="lh-card-tag">{{ e.data.featuredTag }}</p>
          <h3 class="lh-card-title">{{ e.data.featuredTitle }}</h3>
          <p class="lh-card-desc">{{ e.data.featuredDescription }}</p>
          <span class="lh-card-cta">View case <span aria-hidden="true">→</span></span>
        </div>
      </a>
      {% endfor -%}
    </div>
    <a href="{{ home.selectedProjects.viewAllUrl }}" class="btn-link">{{ home.selectedProjects.viewAllLabel }} <span aria-hidden="true">→</span></a>
  </div>
</section>

<!-- ─── FOCUS AREAS ─── -->
<section class="band band-soft">
  <div class="container">
    <header class="band-header reveal">
      <p class="eyebrow">{{ home.focusAreas.eyebrow }}</p>
      <h2 class="t-display-lg">{{ home.focusAreas.heading }}</h2>
    </header>
    <div class="focus-grid">
      {% for item in home.focusAreas.items -%}
      <div class="focus-item reveal" data-delay="{{ loop.index }}">
        <h3>{{ item.title | safe }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {% endfor -%}
    </div>
  </div>
</section>

<!-- ─── FINAL CTA ─── -->
<section class="band band-dark">
  <div class="container-narrow center">
    <h2 class="t-display-lg reveal">{{ home.finalCta.heading }}</h2>
    <p class="t-body-lg t-muted-on-dark reveal" data-delay="1" style="margin-top: 1.25rem;">{{ home.finalCta.text }}</p>
    <div class="hero-ctas reveal" data-delay="2" style="justify-content: center;">
      <a href="{{ home.finalCta.primaryUrl }}" class="btn btn-primary-on-dark">{{ home.finalCta.primaryLabel }}</a>
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener" class="btn-link-on-dark">{{ home.finalCta.linkLabel }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
