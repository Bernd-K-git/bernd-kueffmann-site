---
permalink: /contact.html
layout: layouts/base.njk
eleventyComputed:
  title: "{{ contact.title }}"
  metaDescription: "{{ contact.metaDescription }}"
---

<!-- ─── HERO ─── -->
<section class="hero">
  <div class="container-narrow">
    <p class="eyebrow reveal">{{ contact.hero.eyebrow }}</p>
    <h1 class="hero-h1 reveal" data-delay="1">{{ contact.hero.heading }}</h1>
  </div>
</section>

<!-- ─── CONTACT BLOCK ─── -->
<section class="band">
  <div class="container">
    <div class="contact-grid">
      <div class="reveal">
        {% for paragraph in contact.intro -%}
          <p>{{ paragraph | safe | replace("**Typical response within 1–2 business days.**", "<strong>Typical response within 1&ndash;2 business days.</strong>") }}</p>
        {% endfor -%}
      </div>
      <div class="contact-methods reveal" data-delay="1">
        <div>
          <div class="contact-method-label">Email</div>
          <a class="contact-method-value" href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
        <div>
          <div class="contact-method-label">LinkedIn</div>
          <a class="contact-method-value" href="{{ site.linkedin }}" target="_blank" rel="noopener">{{ site.linkedinLabel }}</a>
        </div>
        {% if site.phone -%}
        <div>
          <div class="contact-method-label">Phone</div>
          <a class="contact-method-value" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>
        </div>
        {% endif -%}
        <div>
          <div class="contact-method-label">Office</div>
          <span class="contact-method-value">{{ site.office }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── SHORT FORM ─── -->
<section class="band band-soft">
  <div class="container">
    <header class="band-header reveal" style="text-align: center; margin-left: auto; margin-right: auto;">
      <p class="eyebrow">{{ contact.form.eyebrow }}</p>
      <h2 class="t-display-md">{{ contact.form.heading }}</h2>
      <p class="t-body t-muted" style="margin-top: 1rem;">{{ contact.form.hint }}</p>
    </header>

    <form class="contact-form reveal" action="https://formspree.io/f/{{ site.formspreeId }}" method="POST">
      <div class="field">
        <label for="contact-name">Name</label>
        <input type="text" id="contact-name" name="name" required autocomplete="name">
      </div>
      <div class="field">
        <label for="contact-email">Email</label>
        <input type="email" id="contact-email" name="email" required autocomplete="email">
      </div>
      <div class="field">
        <label for="contact-message">Message</label>
        <textarea id="contact-message" name="message" required rows="6"></textarea>
      </div>
      <div class="honeypot" aria-hidden="true">
        <label for="contact-website">Website (leave blank)</label>
        <input type="text" id="contact-website" name="_gotcha" tabindex="-1" autocomplete="off">
      </div>
      <button type="submit" class="btn btn-primary">{{ contact.form.submitLabel }}</button>
    </form>
  </div>
</section>
