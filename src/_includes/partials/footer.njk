<footer class="footer">
  <div class="footer-inner">
    <div class="footer-cols">
      <div>
        <div class="footer-title">{{ site.name }}</div>
        <p class="footer-sub">{{ site.footerStrap | safe | replace("\n", "<br>") }}</p>
      </div>
      <div>
        <div class="footer-label">Site</div>
        {% for item in nav.items -%}
          {% if item.url !== '/' %}<a href="{{ item.url }}">{{ item.label | replace("Selected Projects", "Selected Projects") | replace("Training & Mentoring", "Training") }}</a>{% endif %}
        {% endfor -%}
      </div>
      <div>
        <div class="footer-label">Connect</div>
        <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="mailto:{{ site.email }}">Email</a>
      </div>
      <div>
        <div class="footer-label">Legal</div>
        <a href="/imprint.html">Imprint</a>
        <a href="/privacy.html">Privacy</a>
        <a href="/cookies.html" data-reopen-cookies>Cookie Settings</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span data-year>{{ "" | year }}</span> {{ site.name }}. All rights reserved.</span>
      <span>{{ site.office }}</span>
    </div>
  </div>
</footer>
