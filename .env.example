# Local development environment variables.
# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# Anthropic API key for the chat widget — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Optional model override; defaults to claude-haiku-4-5-20251001.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# GitHub OAuth credentials for the Decap CMS admin (Bernd's editor).
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: https://transion.org/api/oauth?action=callback
# These are typically only needed in production (Vercel env vars), not for local dev.
GITHUB_OAUTH_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
